<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>appcontainerexe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
		<Platforms>x64;x86;ARM64</Platforms>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<MileXamlNoSunValleyXamlStyle>true</MileXamlNoSunValleyXamlStyle>
	</PropertyGroup>

	<PropertyGroup>
		<AppxPackage>true</AppxPackage>
		<EnableMsixTooling>true</EnableMsixTooling>
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<ItemGroup>
		<ProjectCapability Include="Msix" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" IncludeAssets="none" />
		<PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.4654" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" IncludeAssets="build" PrivateAssets="all" IsImplicitlyDefined="true" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250806.1" IncludeAssets="build" PrivateAssets="all" IsImplicitlyDefined="true" />
		<PackageReference Include="Mile.Xaml" Version="2.5.1250" IncludeAssets="build" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\*" />
		<Reference Include="$(PkgMicrosoft_UI_Xaml)\lib\uap10.0\Microsoft.UI.Xaml.winmd" />
		<Reference Include="$(PkgMicrosoft_Web_WebView2)\lib\Microsoft.Web.WebView2.Core.winmd" />
	    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-$(Platform)\native_uap\Microsoft.Web.WebView2.Core.dll" />
	</ItemGroup>
</Project>
