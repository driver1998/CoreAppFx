<Page
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="CoreAppFx.MainPage"
	xmlns:local="using:CoreAppFx">

    <NavigationView x:Name="NavView" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Colors" Tag="color">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Todo" Tag="todo">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D5;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="WebView" Tag="webView">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE774;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="rootFrame"/>
    </NavigationView>
</Page>